NVIDIA_API_KEY=nvapi-...
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Only needed if switching providers
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=AIza...

# Choose provider: nvidia | openai | anthropic | gemini  (default: nvidia)
LLM_PROVIDER=nvidia

# Models per stage — default: openai/gpt-oss-120b
PLANNER_MODEL=openai/gpt-oss-120b
RERANKER_MODEL=openai/gpt-oss-120b
SCORER_MODEL=openai/gpt-oss-120b
REFLECTOR_MODEL=openai/gpt-oss-120b
NAIVE_MODEL=openai/gpt-oss-120b

# Embedding provider — auto-matches LLM_PROVIDER when not set
# nvidia uses nv-embedqa-e5-v5 (batched, fast)
# gemini uses gemini-embedding-2
EMBED_PROVIDER=nvidia
EMBED_MODEL=nvidia/nv-embedqa-e5-v5

# Routing thresholds
CONFIDENCE_FLOOR=0.7
REQUIRED_ACCEPT_SCORE=0.75
PARTIAL_MATCH_SCORE=0.25
